 "scenes": {
  "debtor_meet": {
   "speaker": "debtor",
   "text": "{debtor.first} {debtor.family} catches your sleeve. \"I owe {collector.name}. If a friend could bring the money from my sister's place, quietly…\"",
   "choices": [
    {
     "text": "\"I'll carry it.\"",
     "flags": [
      "carries_payment"
     ]
    },
    {
     "text": "\"Sorry, I can't.\"",
     "flags": [
      "refused_debtor"
     ]
    }
   ]
  },
  "payment_done": {
   "speaker": "debtor",
   "text": "{debtor.first} counts it twice and breathes out for the first time in a week. \"I won't forget this.\"",
   "choices": [
    {
     "text": "\"Stay out of debt.\""
    }
   ]
  },
  "refused": {
   "speaker": "debtor",
   "text": "{debtor.first} nods and looks away. Two days later their door has a new lock and a gang tag.",
   "choices": [
    {
